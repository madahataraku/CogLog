<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Needed to download the local fallback model. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <queries>
    <package android:name="com.google.android.aicore" />
  </queries>
  <application>
    <!-- Warm Generation.getClient() at process start (mlkit#1071 timing race). -->
    <provider
      android:name="dev.flutter_device_ai.FlutterDeviceAiInitProvider"
      android:authorities="${applicationId}.flutterdeviceai.init"
      android:exported="false"
      android:initOrder="100" />
  </application>
</manifest>
