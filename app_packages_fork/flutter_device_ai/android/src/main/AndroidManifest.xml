<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Needed to download the local fallback model. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Required by genai-prompt to bind AICore (also declared in the AAR). -->
  <uses-permission android:name="com.google.android.apps.aicore.service.BIND_SERVICE" />
  <queries>
    <package android:name="com.google.android.aicore" />
  </queries>
  <application>
    <!-- Mark process start only; do not call Generation.getClient here. -->
    <provider
      android:name="dev.flutter_device_ai.FlutterDeviceAiInitProvider"
      android:authorities="${applicationId}.flutterdeviceai.init"
      android:exported="false"
      android:initOrder="98" />
  </application>
</manifest>
